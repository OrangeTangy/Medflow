# Production values are injected from a secret manager. Never commit a filled file.
ENVIRONMENT=production
PUBLIC_ORIGIN=https://medflow.example.org
DATABASE_URL=postgresql+psycopg://app_login:CHANGE_ME@postgres/medflow
AUTH_DATABASE_URL=postgresql+psycopg://auth_login:CHANGE_ME@postgres/medflow
WORKER_DATABASE_URL=postgresql+psycopg://worker_login:CHANGE_ME@postgres/medflow
REDIS_URL=redis://redis:6379/0
OIDC_ISSUER=https://identity.example.org/realms/hospital
OIDC_CLIENT_ID=medflow
OIDC_CLIENT_SECRET=
OIDC_MFA_CLAIM=mfa
SESSION_SECRET=
INTEGRATION_SECRET=
INTEGRATION_ORGANIZATION_ID=
PRESENCE_GRACE_SECONDS=300
PRESENCE_STALE_SECONDS=900
TRANSCRIPTION_APPROVED=false
TRANSCRIPTION_ENDPOINT=
TRANSCRIPTION_API_KEY=
AUDIO_BUCKET=
AUDIO_KMS_KEY=
AUDIO_RETENTION_DAYS=0
